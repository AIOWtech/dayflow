{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/server.js"
    },
    {
      "src": "/privacy-policy/?",
      "dest": "/public/privacy-policy.html"
    },
    {
      "src": "/terms/?",
      "dest": "/public/terms.html"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
